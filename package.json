{
  "name": "agent-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bash ./start.sh",
    "start:web": "node scripts/formal-dev.mjs --web",
    "start:desktop": "node scripts/formal-dev.mjs",
    "desktop:start": "node scripts/formal-dev.mjs",
    "desktop:dev": "node scripts/formal-dev.mjs",
    "dev": "node scripts/formal-dev.mjs --web",
    "dev:ui": "vite --config vite.runtime.config.ts",
    "build": "npm run typecheck && vite build --config vite.runtime.config.ts",
    "build:runtime": "npm run typecheck && vite build --config vite.runtime.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:vitest && npm run test:desktop",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:desktop": "node --test apps/desktop/*.test.cjs",
    "test:watch": "vitest --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.config.ts tests/contracts packages/provider-port packages/test-kit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration packages/provider-opencode packages/provider-codex packages/provider-claude-code",
    "test:e2e": "vitest run --config vitest.config.ts tests/e2e",
    "runtime:dev": "tsx apps/runtime-host/src/index.ts",
    "test:formal-dev-launcher": "node --test scripts/formal-dev.test.mjs",
    "desktop:runtime": "tsc --noEmit && vite build --config vite.runtime.config.ts && electron apps/desktop/main.cjs",
    "reference:claudian:update": "bash scripts/sync-claudian-reference.sh",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "electron": "^42.5.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  }
}
