  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "desktop:dev": "node desktop/dev.cjs",
    "desktop:start": "node desktop/start.cjs",
    "desktop:smoke": "electron desktop/electron-bridge-smoke.cjs",
    "desktop:harness-surface-smoke": "electron desktop/harness-surface-smoke.cjs",
    "desktop:agent-loop-ui-smoke": "electron desktop/agent-loop-v1-ui-smoke.cjs",
